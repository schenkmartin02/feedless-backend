# Masold at a VPS-en /opt/feedless/.env neven, toltsd ki, majd: chmod 600 .env
# Ez a fajl (a .example) mehet gitbe. A kitoltott .env SOHA.

# A Postgres ezzel indul, es a backend ezzel csatlakozik - a ketto ugyanaz az ertek.
# Ha kesobb megvaltoztatod, a mar letrehozott adatbazisban a jelszo NEM valtozik
# magatol: ALTER USER kell hozza.
POSTGRES_PASSWORD=

# A Redis --requirepass-a es a backend spring.data.redis.password-e.
REDIS_PASSWORD=

# Riot API kulcs. A personal kulcs 24 orankent lejar - eles uzemre a production
# kulcs kell. A neve pontosan RIOT_KEY, mert az application.yml ezt varja.
RIOT_KEY=
